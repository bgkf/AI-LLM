# multi-agent-tools — environment configuration
# Copy to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Anthropic (default provider) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here

# ── Local LLM (OpenAI-compatible endpoint) ────────────────────────────────────
# llama.cpp default:   http://localhost:8080/v1
# Ollama default:      http://localhost:11434/v1
# LM Studio default:   http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# Model name to send to local server.
# llama.cpp ignores this (uses whatever model is loaded).
# Ollama requires the exact model name, e.g. llama3.2, mistral, etc.
LOCAL_LLM_MODEL=local

# Some local servers require a non-empty API key (any string works).
LOCAL_LLM_API_KEY=not-needed

# ── GitHub (for posting PR review comments — not yet implemented) ─────────────
# GITHUB_TOKEN=ghp_your_token_here
