# Google Calendar — uses GAM (Google Apps Manager)
GAM_PATH=~/bin/gam7/gam
GAM_USER=<USER_NAME>

# Linear — Personal API key from https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx

# Notion — Internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_xxxxxxxxxxxx

# Slack — User OAuth token from https://api.slack.com/apps (needs search:read, stars:read)
SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxx
